# MSC SRM AP — Production Environment Variables Template
# Copy to .env.local for local development. Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=https://mscsrmap.xyz
ALLOWED_ORIGINS=https://mscsrmap.xyz,https://www.mscsrmap.xyz,http://localhost:3000,http://127.0.0.1:3000

NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# 32-byte encryption key for AES-256-GCM (generate with: openssl rand -hex 16 or 32 raw bytes)
DB_ENCRYPTION_KEY=01234567890123456789012345678901

# Upstash Redis for rate limiting. It is mandatory in production: registration,
# auth, ticket recovery, payments and admin actions fail closed without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only accept client IPs from the configured hosting proxy. Supported values:
# vercel (x-vercel-forwarded-for), cloudflare (cf-connecting-ip), or unset.
TRUSTED_PROXY_MODE=

RATE_LIMIT_DEFAULT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX_REQUESTS=30

# Generate a unique secret with: openssl rand -hex 32
CRON_SECRET=

# Free-tier transactional email (Resend or Brevo)
RESEND_API_KEY=

# Google Wallet event ticket passes. Class must be created in Google Wallet Console.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=
# Service account JSON content from the Google Wallet issuer project. Keep server-side only.
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# Apple Wallet pass signing. Values are PEM certificate/key contents, not file paths.
APPLE_WALLET_PASS_TYPE_IDENTIFIER=
APPLE_WALLET_TEAM_IDENTIFIER=
APPLE_WALLET_ORGANIZATION=Microsoft Student Community
APPLE_WALLET_SIGNING_CERTIFICATE=
APPLE_WALLET_PRIVATE_KEY=
APPLE_WALLET_WWDR_CERTIFICATE=
